\appendices
\section{Rapp-Amplifier Bussgang Moments}
Let $t=|u|^2/P\sim\mathrm{Exp}(1)$ and $\rho=p^2P/A^2$. Then
\begin{align}
\kappa&=p\,\E_t\!\bigl[t\,(1+\rho^2t^2)^{-1/4}\bigr],\\
\E|g(u)|^2&=p^2P\,\E_t\!\bigl[t\,(1+\rho^2t^2)^{-1/2}\bigr],\\
\sigma_d^2&=\E|g(u)|^2-\kappa^2P.
\end{align}
These follow from \eqref{eq:rapp} with $|u|^2=Pt$.

